Satu Detail Tambahan pada Kode (Opsional tapi Penting)
Pada baris redirect: "manual", jika project Pages Anda melakukan redirect (misalnya redirect /about ke /about/ atau trailing slash), browser akan menerima header Location yang mengarah ke nama-project-anda.pages.dev jika tidak ditulis ulang. Agar URL di browser tetap bertahan di *.vz.gay saat terjadi redirect, Anda bisa sedikit menyempurnakan bagian akhir return menjadi:

JavaScript
export default {
  async fetch(request) {
    const url = new URL(request.url);
    const originalHost = url.hostname;
    const pagesHost = "nama-project-anda.pages.dev";

    url.hostname = pagesHost;

    const headers = new Headers(request.headers);
    headers.set("X-Forwarded-Host", originalHost);
    headers.set("X-Original-Host", originalHost);

    const response = await fetch(url.toString(), {
      method: request.method,
      headers: headers,
      body: request.body,
      redirect: "manual",
    });

    // Pastikan header Location saat redirect tetap memakai subdomain *.vz.gay
    const newHeaders = new Headers(response.headers);
    const location = newHeaders.get("Location");
    if (location && location.includes(pagesHost)) {
      newHeaders.set("Location", location.replace(pagesHost, originalHost));
    }

    return new Response(response.body, {
      status: response.status,
      statusText: response.statusText,
      headers: newHeaders,
    });
  },
};
