# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Auth0 SSO Configuration for files.vz.gay / file.vz.gay (VZ Files · tenant galbay)
VITE_AUTH0_DOMAIN="accounts.vz.gay"
VITE_AUTH0_CLIENT_ID="wxhySCLqtKPGy53uEVWvH2RumGdIp1DP"
# Optional override; leave commented out so both https://files.vz.gay/ and https://file.vz.gay/ resolve automatically
# VITE_AUTH0_REDIRECT_URI="https://files.vz.gay/"
VITE_ACCOUNT_PORTAL_URL="https://myaccount.vz.gay"
